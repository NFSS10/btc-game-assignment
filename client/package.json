{
    "name": "btc-game-client",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@11.9.0",
    "type": "module",
    "scripts": {
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "prettier-check": "prettier --check \"./**/*.+(ts|js|mjs|tsx|jsx|json|css)\"",
        "prettier": "prettier --write \"./**/*.+(ts|js|mjs|tsx|jsx|json|css)\"",
        "pretty": "pnpm prettier && pnpm lint-fix",
        "type-check": "tsc -p tsconfig.json -noEmit",
        "test": "vitest run",
        "dev": "vite --port 3000",
        "build": "tsc -b && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@mantine/core": "^9.5.2",
        "@mantine/hooks": "^9.5.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "postcss": "^8.5.26",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
